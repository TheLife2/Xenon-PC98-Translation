# --- 게임 원본/저작물 - 저장소에 올리지 않는다 ---------------------------
# 빌드된 디스크 이미지(게임 전체가 들어 있다)와 실행 결과물
out/
# 게임에서 추출한 원본 그래픽과 그 렌더링 (CG 아트 포함)
gfx/raw/
gfx/png/
gfx/png_adt/
gfx/png_anim/
gfx/png_word/
gfx/sheet_*.png
gfx/ui_text.png
gfx/AGS.EXE
gfx/AGS.reko/

# ADT 컨테이너 편집본은 원본 프레임 28개를 그대로 안고 있어 사실상 게임 자산이다.
# (다른 gfx/edit/*.GDT 는 우리가 다시 그린 스프라이트라 성격이 다르다)
# tools/gfx_adt_credit.py 로 각자 재생성한다.
gfx/edit/*.ADT
# 게임 스크립트 바이너리 (원본/병합/압축)
scripts_src/
scripts_merge/
scripts_build/

# 글꼴 비교 렌더 (미리보기에 게임 배경이 합성돼 있다. report.tsv 만 남긴다)
gfx/font_survey/*.png
gfx/font_survey/each/

# --- 작업 부산물 -------------------------------------------------------
*.bak.*
translation/batches/
translation/새 폴더/
translation/todo/
translation/review/
__pycache__/
*.pyc
